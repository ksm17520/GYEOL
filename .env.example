# AI 추천 · 취향 분석 · 감상처 확인용 (선택). 없으면 시험용 목록/규칙 기반으로 동작합니다.
# 반드시 서버 환경 변수로만 설정하세요. (NEXT_PUBLIC_ 접두사를 붙이지 마세요)
GEMINI_API_KEY=
# 사용할 Gemini 모델 ID (기본값: gemini-2.5-flash)
GEMINI_MODEL=
# 기본 모델이 없거나 혼잡할 때 쓸 보조 모델(기본 gemini-2.5-flash-lite)
GEMINI_FALLBACK_MODEL=

# 표지 조회 확장 출처(예스24·알라딘 검색 페이지 파싱, IMDb 비공식 검색, 네이버웹툰 비공식 API) 사용 여부.
# 기본값은 켜짐(무료 서비스 단계). 결제(유료)를 열 때는 off 로 바꾸세요.
COVER_EXTENDED_SOURCES=on

# 영화·드라마 포스터 조회용 TMDB 무료 API 키(선택). https://www.themoviedb.org/settings/api 에서 발급.
# 국내 영화·드라마까지 가장 잘 찾으며, 약관상 비상업 용도는 무료입니다(상업 이용 시 TMDB 약관 확인).
TMDB_API_KEY=
